<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="Definitions_1">

  <collaboration id="Collaboration_1">
    <participant id="Pool_1" name="Расчет плановой калькуляции по заявке" processRef="Process_1" />
  </collaboration>

  <process id="Process_1" isExecutable="false">

    <laneSet id="LaneSet_1">
      <lane id="lane_economist" name="Экономист">
        <flowNodeRef>start_poyavilas_novaya_zad</flowNodeRef>
        <flowNodeRef>task_prosmotret_dokumenty</flowNodeRef>
        <flowNodeRef>gw_izdelie_iz_prajsa</flowNodeRef>
        <flowNodeRef>task_vzyat_tsenu_iz_prajs</flowNodeRef>
        <flowNodeRef>end_raschet_po_prajsu_go</flowNodeRef>
        <flowNodeRef>task_zapolnit_kalkulyatsi</flowNodeRef>
        <flowNodeRef>task_otpravit_na_soglasov</flowNodeRef>
        <flowNodeRef>task_prikrepit_finalnyj_r</flowNodeRef>
      </lane>
      <lane id="lane_finance_director" name="Финансовый директор">
        <flowNodeRef>gw_findirektor_soglasov</flowNodeRef>
        <flowNodeRef>task_vnesti_izmeneniya</flowNodeRef>
        <flowNodeRef>end_raschet_soglasovan</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="start_poyavilas_novaya_zad" name="Появилась новая задача">
      <outgoing>flow_1</outgoing>
    </startEvent>
    <task id="task_prosmotret_dokumenty" name="Просмотреть документы заявки">
      <incoming>flow_1</incoming>
      <outgoing>flow_2</outgoing>
    </task>
    <exclusiveGateway id="gw_izdelie_iz_prajsa" name="Изделие из прайса?" gatewayDirection="Diverging">
      <incoming>flow_2</incoming>
      <outgoing>flow_3</outgoing>
      <outgoing>flow_5</outgoing>
    </exclusiveGateway>
    <task id="task_vzyat_tsenu_iz_prajs" name="Взять цену из прайса">
      <incoming>flow_3</incoming>
      <outgoing>flow_4</outgoing>
    </task>
    <endEvent id="end_raschet_po_prajsu_go" name="Расчет по прайсу готов">
      <incoming>flow_4</incoming>
    </endEvent>
    <task id="task_zapolnit_kalkulyatsi" name="Заполнить калькуляцию">
      <incoming>flow_5</incoming>
      <outgoing>flow_6</outgoing>
    </task>
    <task id="task_otpravit_na_soglasov" name="Отправить на согласование">
      <incoming>flow_6</incoming>
      <outgoing>flow_7</outgoing>
    </task>
    <exclusiveGateway id="gw_findirektor_soglasov" name="Финдиректор согласовал?" gatewayDirection="Diverging">
      <incoming>flow_7</incoming>
      <outgoing>flow_8</outgoing>
      <outgoing>flow_9</outgoing>
    </exclusiveGateway>
    <task id="task_vnesti_izmeneniya" name="Внести изменения">
      <incoming>flow_9</incoming>
      <outgoing>flow_10</outgoing>
    </task>
    <task id="task_prikrepit_finalnyj_r" name="Прикрепить финальный расчет">
      <incoming>flow_8</incoming>
      <incoming>flow_10</incoming>
      <outgoing>flow_11</outgoing>
    </task>
    <endEvent id="end_raschet_soglasovan" name="Расчет согласован">
      <incoming>flow_11</incoming>
    </endEvent>

    <sequenceFlow id="flow_1"
                  sourceRef="start_poyavilas_novaya_zad"
                  targetRef="task_prosmotret_dokumenty"
 />
    <sequenceFlow id="flow_2"
                  sourceRef="task_prosmotret_dokumenty"
                  targetRef="gw_izdelie_iz_prajsa"
 />
    <sequenceFlow id="flow_3"
                  sourceRef="gw_izdelie_iz_prajsa"
                  targetRef="task_vzyat_tsenu_iz_prajs"
name="Да" />
    <sequenceFlow id="flow_4"
                  sourceRef="task_vzyat_tsenu_iz_prajs"
                  targetRef="end_raschet_po_prajsu_go"
 />
    <sequenceFlow id="flow_5"
                  sourceRef="gw_izdelie_iz_prajsa"
                  targetRef="task_zapolnit_kalkulyatsi"
name="Нет" />
    <sequenceFlow id="flow_6"
                  sourceRef="task_zapolnit_kalkulyatsi"
                  targetRef="task_otpravit_na_soglasov"
 />
    <sequenceFlow id="flow_7"
                  sourceRef="task_otpravit_na_soglasov"
                  targetRef="gw_findirektor_soglasov"
 />
    <sequenceFlow id="flow_8"
                  sourceRef="gw_findirektor_soglasov"
                  targetRef="task_prikrepit_finalnyj_r"
name="Да" />
    <sequenceFlow id="flow_9"
                  sourceRef="gw_findirektor_soglasov"
                  targetRef="task_vnesti_izmeneniya"
name="Нет" />
    <sequenceFlow id="flow_10"
                  sourceRef="task_vnesti_izmeneniya"
                  targetRef="task_prikrepit_finalnyj_r"
 />
    <sequenceFlow id="flow_11"
                  sourceRef="task_prikrepit_finalnyj_r"
                  targetRef="end_raschet_soglasovan"
 />

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="2316" height="280" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="lane_economist_di" bpmnElement="lane_economist" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2286" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_finance_director_di" bpmnElement="lane_finance_director" isHorizontal="true">
        <dc:Bounds x="160" y="220" width="2286" height="140" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="start_poyavilas_novaya_zad_di" bpmnElement="start_poyavilas_novaya_zad">
        <dc:Bounds x="230" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prosmotret_dokumenty_di" bpmnElement="task_prosmotret_dokumenty">
        <dc:Bounds x="430" y="120" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_izdelie_iz_prajsa_di" bpmnElement="gw_izdelie_iz_prajsa" isMarkerVisible="true">
        <dc:Bounds x="630" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_vzyat_tsenu_iz_prajs_di" bpmnElement="task_vzyat_tsenu_iz_prajs">
        <dc:Bounds x="830" y="120" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_raschet_po_prajsu_go_di" bpmnElement="end_raschet_po_prajsu_go">
        <dc:Bounds x="1230" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_zapolnit_kalkulyatsi_di" bpmnElement="task_zapolnit_kalkulyatsi">
        <dc:Bounds x="1030" y="120" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_otpravit_na_soglasov_di" bpmnElement="task_otpravit_na_soglasov">
        <dc:Bounds x="1430" y="120" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_findirektor_soglasov_di" bpmnElement="gw_findirektor_soglasov" isMarkerVisible="true">
        <dc:Bounds x="1630" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_vnesti_izmeneniya_di" bpmnElement="task_vnesti_izmeneniya">
        <dc:Bounds x="1830" y="260" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prikrepit_finalnyj_r_di" bpmnElement="task_prikrepit_finalnyj_r">
        <dc:Bounds x="2030" y="120" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_raschet_soglasovan_di" bpmnElement="end_raschet_soglasovan">
        <dc:Bounds x="2230" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="266" y="150" />
        <di:waypoint x="430" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="590" y="150" />
        <di:waypoint x="630" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="680" y="150" />
        <di:waypoint x="830" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="735"
                     y="140"
                     width="60" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="990" y="150" />
        <di:waypoint x="1230" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="680" y="150" />
        <di:waypoint x="1030" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="835"
                     y="140"
                     width="60" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="1190" y="150" />
        <di:waypoint x="1430" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_7_di" bpmnElement="flow_7">
        <di:waypoint x="1590" y="150" />
        <di:waypoint x="1630" y="150" />
        <di:waypoint x="1630" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_8_di" bpmnElement="flow_8">
        <di:waypoint x="1680" y="290" />
        <di:waypoint x="2030" y="290" />
        <di:waypoint x="2030" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1835"
                     y="210"
                     width="60" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_9_di" bpmnElement="flow_9">
        <di:waypoint x="1680" y="290" />
        <di:waypoint x="1830" y="290" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1735"
                     y="280"
                     width="60" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_10_di" bpmnElement="flow_10">
        <di:waypoint x="1990" y="290" />
        <di:waypoint x="2030" y="290" />
        <di:waypoint x="2030" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_11_di" bpmnElement="flow_11">
        <di:waypoint x="2190" y="150" />
        <di:waypoint x="2230" y="150" />
        <di:waypoint x="2230" y="290" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>